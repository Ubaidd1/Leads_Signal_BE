# development | test | production
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://hiring_user:CHANGE_ME@localhost:5432/hiring_intelligence
# Used only by the test suite. Must be a separate, disposable database.
TEST_DATABASE_URL=postgresql+psycopg://hiring_user:CHANGE_ME@localhost:5432/hiring_intelligence_test

# Public URL of the Next.js app (used in password-reset and invitation links).
FRONTEND_BASE_URL=http://localhost:3000
# Comma-separated origins allowed to make state-changing requests (CSRF origin check)
# and cross-origin calls (CORS). Not needed for CORS when Next.js proxies /api/v1.
TRUSTED_ORIGINS=http://localhost:3000

# Session cookie. COOKIE_SECURE must be true in production (HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
SESSION_IDLE_TIMEOUT_MINUTES=720
SESSION_ABSOLUTE_TIMEOUT_HOURS=24
SESSION_REMEMBER_ME_DAYS=30

ALLOW_REGISTRATION=true
# console = development-only adapter that logs messages instead of sending them.
EMAIL_BACKEND=console

LOG_LEVEL=INFO
